{
    "agent_servers": {
        "claude-acp": {
            "type": "registry"
        }
    },
    "session": {
        "trust_all_worktrees": true
    },
    "debugger": {
        "dock": "left",
    },
    "git": {
        "inline_blame": {
            "show_commit_summary": false,
        },
    },
    "edit_predictions": {
        "provider": "copilot",
    },
    "agent": {
        "dock": "right",
        "sidebar_side": "right",
        "show_turn_stats": true,
        "default_profile": "write",
        "enable_feedback": false,
        "default_model": {
            "enable_thinking": true,
            "effort": "high",
            "provider": "copilot_chat",
            "model": "gemini-3.1-pro-preview",
        },
    },
    "icon_theme": "Flow Deep",
    "telemetry": {
        "metrics": false,
        "diagnostics": false,
    },
    "theme": "Cursor Dark",
    "cursor_blink": true,
    "use_system_prompts": false,
    "ui_font_family": "CaskaydiaCove Nerd Font Mono",
    "buffer_font_family": "CaskaydiaCove Nerd Font Mono",
    "restore_on_startup": "launchpad",
    "autosave": { "after_delay": { "milliseconds": 500 } },
    "buffer_font_size": 14,
    "buffer_line_height": {
        "custom": 1.4,
    },
    "soft_wrap": "editor_width",
    "toolbar": {
        "breadcrumbs": false,
        "quick_actions": false,
        "selections_menu": false,
    },
    "terminal": {
        "cursor_shape": "bar",
        "font_family": "CaskaydiaCove Nerd Font Mono",
    },

    "experimental.theme_overrides": {
        "panel.focused_border": "#00000000",
        "editor.document_highlight.bracket_background": "#ffffff00",
    },
    "tabs": {
        "file_icons": true,
        "git_status": true,
        "show_diagnostics": "errors",
    },
    "tab_bar": {
        "show_nav_history_buttons": false,
    },
    "project_panel": {
        "dock": "left",
        "default_width": 280,
        "entry_spacing": "standard",
        "auto_fold_dirs": false,
        "scrollbar": {
            "show": "never",
        },
        "git_status_indicator": true,
    },
    "tab_size": 4,
    "diagnostics": {
        "inline": {
            "enabled": true,
            "min_column": 80,
            "max_severity": "warning",
        },
    },
    "git_panel": {
        "dock": "left",
        "tree_view": true,
        "default_width": 280,
    },
    "scrollbar": {
        "axes": {
            "horizontal": false,
        },
    },
    "preview_tabs": {
        "enabled": false,
        "enable_preview_from_file_finder": true,
        "enable_keep_preview_on_code_navigation": true,
    },
    "title_bar": {
        "show_branch_status_icon": true,
        "show_menus": false,
    },
    "collaboration_panel": {
        "button": false,
    },
    "outline_panel": {
        "button": false,
    },
    "languages": {
        "JavaScript": {
            "code_actions_on_format": {
                "source.organizeImports": true,
                "source.fixAll.eslint": true,
            },
        },
        "TypeScript": {
            "code_actions_on_format": {
                "source.organizeImports": true,
                "source.fixAll.eslint": true,
            },
        },
        "TSX": {
            "code_actions_on_format": {
                "source.organizeImports": true,
                "source.fixAll.eslint": true,
            },
        },
        "CSS": {
            "language_servers": [
                "tailwindcss-intellisense-css",
                "!vscode-css-language-server",
                "...",
            ],
        },
        "Markdown": {
            "format_on_save": "on",
            "formatter": "prettier",
            "remove_trailing_whitespace_on_save": false,
        },
    },
    "lsp": {
        "vtsls": {
            "settings": {
                "typescript": {
                    "inlayHints": {
                        "parameterNames": {
                            "enabled": "literals",
                            "suppressWhenArgumentMatchesName": true,
                        },
                        "parameterTypes": {
                            "enabled": true,
                        },
                        "variableTypes": {
                            "enabled": true,
                            "suppressWhenTypeMatchesName": true,
                        },
                        "propertyDeclarationTypes": {
                            "enabled": true,
                        },
                        "functionLikeReturnTypes": {
                            "enabled": true,
                        },
                        "enumMemberValues": {
                            "enabled": true,
                        },
                    },
                },
                "javascript": {
                    "inlayHints": {
                        "parameterNames": {
                            "enabled": "literals",
                            "suppressWhenArgumentMatchesName": true,
                        },
                        "parameterTypes": {
                            "enabled": true,
                        },
                        "variableTypes": {
                            "enabled": true,
                            "suppressWhenTypeMatchesName": true,
                        },
                        "propertyDeclarationTypes": {
                            "enabled": true,
                        },
                        "functionLikeReturnTypes": {
                            "enabled": true,
                        },
                        "enumMemberValues": {
                            "enabled": true,
                        },
                    },
                },
            },
        },
        "tailwindcss-language-server": {
            "settings": {
                "includeLanguages": {
                    "templ": "html",
                },
                "experimental": {
                    "classRegex": [
                        "class=\"([^\"]*)\"",
                        "className=\"([^\"]*)\"",
                    ],
                },
            },
        },
        "gopls": {
            "initialization_options": {
                "hints": {
                    "assignVariableTypes": true,
                    "compositeLiteralFields": true,
                    "compositeLiteralTypes": true,
                    "constantValues": true,
                    "functionTypeParameters": true,
                    "parameterNames": true,
                    "rangeVariableTypes": true,
                },
            },
        },
    },
}
