{
  "files.autoSave": "afterDelay",
  "workbench.iconTheme": "flow-deep",
  "tabout.disableByDefault": false,
  "git.autofetch": true,
  "terminal.external.osxExec": "Warp.app",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "editor.minimap.enabled": false,
  "editor.rulers": [],
  "search.exclude": {
    "**/node_modules": true,
    "node_modules": true,
    "yarn.lock": true,
    "package-lock.json": true,
  },
  "files.associations": {
    "*.css": "tailwindcss",
  },
  "editor.quickSuggestions": {
    "strings": "on",
  },
  "tailwindCSS.includeLanguages": {
    "plaintext": "html",
  },
  "editor.wordWrap": "on",
  "editor.detectIndentation": false,
  "scss.lint.unknownAtRules": "ignore",
  "css.lint.unknownAtRules": "ignore",
  "workbench.list.smoothScrolling": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.links": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always",
  },
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.smoothScrolling": true,
  "workbench.productIconTheme": "fluent-icons",
  "editor.autoClosingBrackets": "always",
  "editor.suggest.showKeywords": false,
  // open json editor for settings
  "workbench.settings.editor": "json",
  // Misc
  "editor.linkedEditing": true,
  // ui
  "window.commandCenter": false,
  // Tabs opening
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "editor.gotoLocation.multipleDefinitions": "goto",
  "js/ts.updateImportsOnFileMove.enabled": "never",
  "explorer.confirmDelete": false,
  // Font related
  "editor.fontLigatures": true,
  "terminal.integrated.sendKeybindingsToShell": true,
  "terminal.integrated.cursorBlinking": true,
  "editor.semanticHighlighting.enabled": false,
  "workbench.tree.indent": 16,
  "breadcrumbs.enabled": false,
  "explorer.compactFolders": false,
  "terminal.integrated.fontFamily": "CaskaydiaCove Nerd Font Mono",
  "extensions.ignoreRecommendations": true,
  "git.blame.editorDecoration.enabled": true,
  "git.blame.statusBarItem.enabled": true,
  "custom-ui-style.font.monospace": "CaskaydiaCove Nerd Font Mono",
  "custom-ui-style.font.sansSerif": "CaskaydiaCove Nerd Font Mono",
  "editor.fontSize": 13,
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "workbench.colorCustomizations": {
    "editor.lineHighlightBorder": "#00000000",
    "focusBorder": "#00000000",
    "[Vesper]": {
      "sideBar.border": "#202020",
      "panel.border": "#202020",
      "activityBar.border": "#202020",
      "statusBar.border": "#202020",
      "editorGroup.border": "#202020",
      "editorGroupHeader.tabsBorder": "#202020",
      "sideBarTitle.border": "#202020",
      "titleBar.border": "#202020",
    },
  },

  "workbench.colorTheme": "Aura Dark",
  "chat.agent.enabled": true,
  "github.copilot.nextEditSuggestions.enabled": false,
  "chat.agent.maxRequests": 100,
  "terminal.integrated.initialHint": false,
  "chat.viewSessions.enabled": false,
  "chat.tips.enabled": false,
  "claudeCode.preferredLocation": "panel",
}
